call.w SEQCLONESTREAM 0001 0100 0001
let 4
call.d SEQSTREAMLEN %4
call.w SEQENUMSTREAMS 0001 cb4 d:00000000
echo == destroy
call.w SEQDESTROYSTREAM %3

load TTSSEQ.DLL -> ok
SEQOPEN(0000,0000) -> 0001
== note on, note off
SEQTXMIDIMSG(0000,0000,0090,003c,0064) -> 0001
SEQTXMIDIMSG(0000,0000,0080,003c,0000) -> 0001
== note off for a note that is not on
SEQTXMIDIMSG(0000,0000,0080,003d,0000) -> 0001
== note on, note on with velocity 0, note off
SEQTXMIDIMSG(0000,0000,0090,003d,0040) -> 0001
SEQTXMIDIMSG(0000,0000,0090,003d,0000) -> 0001
SEQTXMIDIMSG(0000,0000,0080,003d,0000) -> 0001
== the same note twice, then two note offs
SEQTXMIDIMSG(0000,0000,0090,0041,0042) -> 0001
SEQTXMIDIMSG(0000,0000,0090,0041,0043) -> 0001
SEQTXMIDIMSG(0000,0000,0080,0041,0000) -> 0001
SEQTXMIDIMSG(0000,0000,0080,0041,0000) -> 0001
== the channel replaces the status nibble
SEQTXMIDIMSG(0000,0005,0093,0040,0040) -> 0001
SEQTXMIDIMSG(0000,0005,0083,0040,0000) -> 0001
== controller, program, channel and key pressure
SEQTXMIDIMSG(0000,0003,00b0,0007,0050) -> 0001
SEQTXMIDIMSG(0000,0000,00c0,0005,0000) -> 0001
SEQTXMIDIMSG(0000,0002,00d0,0030,0000) -> 0001
SEQTXMIDIMSG(0000,0002,00a0,0030,0020) -> 0001
== the same controller twice
SEQTXMIDIMSG(0000,0000,00b0,0007,0050) -> 0001
SEQTXMIDIMSG(0000,0000,00b0,0007,0050) -> 0001
== pitch wheel
SEQTXMIDIMSG(0000,0000,00e0,0000,0040) -> 0000
SEQTXMIDIMSG(0000,0000,00e0,0010,0050) -> 0000
SEQTXMIDIMSG(0000,0000,00e0,2000,0000) -> 0000
SEQTXMIDIMSG(0000,0000,00ef,0010,0020) -> 0000
== every channel
SEQTXMIDIMSG(0000,00ff,00c0,0007,0000) -> 0001
== every port, channel 3
SEQTXMIDIMSG(ffff,0003,00b0,0001,0002) -> 0001
== every port and channel: note on, note offs
SEQTXMIDIMSG(ffff,00ff,0090,0031,0021) -> 0001
SEQTXMIDIMSG(ffff,00ff,0080,0031,0000) -> 0001
SEQTXMIDIMSG(ffff,00ff,0080,0032,0000) -> 0001
== port 1
SEQTXMIDIMSG(0001,0002,0090,0030,0020) -> 0001
SEQTXMIDIMSG(0001,0002,0080,0030,0000) -> 0001
== channel 16
SEQTXMIDIMSG(0000,0010,0090,0020,0020) -> 0000
== statuses below 0x80 and above 0xef
SEQTXMIDIMSG(0000,0000,0040,0020,0020) -> 0000
SEQTXMIDIMSG(0000,0000,00f0,0020,0020) -> 0000
SEQTXMIDIMSG(0000,0000,00f8,0000,0000) -> 0000
SEQTXMIDIMSG(0000,0000,00ff,0020,0020) -> 0000
== data bytes above 0x7f
SEQTXMIDIMSG(0000,0000,0090,0080,0040) -> 0000
SEQTXMIDIMSG(0000,0000,0090,0040,0080) -> 0000
SEQTXMIDIMSG(0000,0000,00b0,0007,00ff) -> 0000
== the panic of Cakewalk Apprentice 1.04 (excerpt)
SEQTXMIDIMSG(ffff,00ff,0080,003c,0000) -> 0001
SEQTXMIDIMSG(ffff,00ff,00b0,0040,0000) -> 0001
SEQTXMIDIMSG(ffff,00ff,00e0,0000,0040) -> 0000
SEQTXMIDIMSG(ffff,00ff,00b0,0079,0000) -> 0001
== a note left on is turned off at close
SEQTXMIDIMSG(0000,0000,0090,0045,0045) -> 0001
SEQCLOSE() -> 0001
